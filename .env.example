# Copy this to .env and fill in your values

# Tradovate credentials (get from trader.tradovate.com > Account > API)
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_APP_ID=TJRBot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=0
TRADOVATE_SECRET=your_api_secret

# Set to false when ready to go LIVE
TRADOVATE_DEMO=true

# Webhook secret — put same value in TradingView alert
WEBHOOK_SECRET=change-me-to-something-random

# Webhook server port
WEBHOOK_PORT=8000
