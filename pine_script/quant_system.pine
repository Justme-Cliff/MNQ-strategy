alertcondition(vwap_pm_short_sig, "VWAP REV SHORT PM", "ISOGENY - VWAP REV SHORT PM. T1=1R, T2=VWAP. Close by 4PM.")
alertcondition(bnc_am_long_sig,   "VWAP BOUNCE LONG",  "ISOGENY - VWAP BOUNCE LONG: bull trend at VWAP. T1=1R, T2=Chandelier.")
alertcondition(bnc_am_short_sig,  "VWAP BOUNCE SHORT", "ISOGENY - VWAP BOUNCE SHORT: bear trend at VWAP. T1=1R, T2=Chandelier.")
alertcondition(bnc_pm_long_sig,   "VWAP BNC LONG PM",  "ISOGENY - VWAP BOUNCE LONG PM. T1=1R, T2=Chandelier. Close by 4PM.")
alertcondition(bnc_pm_short_sig,  "VWAP BNC SHORT PM", "ISOGENY - VWAP BOUNCE SHORT PM. T1=1R, T2=Chandelier. Close by 4PM.")
alertcondition(bull_fvg_ok,       "BULLISH FVG",       "ISOGENY - BULLISH FVG formed. Watch for fill on return.")
alertcondition(bear_fvg_ok,       "BEARISH FVG",       "ISOGENY - BEARISH FVG formed. Watch for fill on return.")
alertcondition(va_rule_long_sig,  "VA RULE LONG",      "ISOGENY - VA RULE LONG (Type B): 80% probability traverse to VAH.")
alertcondition(va_rule_short_sig, "VA RULE SHORT",     "ISOGENY - VA RULE SHORT (Type A): 80% probability traverse to VAL.")
alertcondition(is_absorb,         "ABSORPTION",        "ISOGENY - ABSORPTION detected. Check direction before entry.")
