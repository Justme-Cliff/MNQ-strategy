//@version=6
indicator("NQ Quant System v2 — MNQ Day Trading", overlay=true,
     max_boxes_count=60, max_labels_count=150, max_lines_count=60)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

g_disp = "Display"
show_orb   = input.bool(true,  "ORB Box (9:30 bar)",          group=g_disp)
show_ib    = input.bool(true,  "IB Box (9:30-10:00)",          group=g_disp)
show_vwap  = input.bool(true,  "VWAP + 2-sigma Bands",         group=g_disp)
show_prev  = input.bool(true,  "Prior Close (gap fill lvl)",   group=g_disp)
show_fvg   = input.bool(true,  "FVG Zones",                    group=g_disp)
show_sigs  = input.bool(true,  "Signal Labels",                group=g_disp)
show_dash  = input.bool(true,  "Regime Dashboard",             group=g_disp)
shade_rth  = input.bool(false, "Shade Trade Window (9:30-12)", group=g_disp)

g_par = "Strategy Parameters"
vix_elev    = input.float(22.0, "VIX Elevated Threshold", group=g_par, minval=15.0, maxval=35.0)
ema_strong  = input.float(3.0,  "EMA% Threshold - strong", group=g_par, minval=1.0,  maxval=5.0)
ema_mild    = input.float(1.0,  "EMA% Threshold - trend",  group=g_par, minval=0.25, maxval=3.0)
orb_min_atr = input.float(0.025,"ORB Min (x ATR)",         group=g_par, minval=0.01, maxval=0.10)
orb_max_atr = input.float(0.50, "ORB Max (x ATR)",         group=g_par, minval=0.10, maxval=1.00)
ib_min_atr  = input.float(0.05, "IB Min (x ATR)",          group=g_par, minval=0.02, maxval=0.15)
ib_max_atr  = input.float(0.65, "IB Max (x ATR)",          group=g_par, minval=0.20, maxval=1.00)

g_src = "Data Sources"
vix_sym = input.string("TVC:VIX", "VIX Symbol", group=g_src)

// ═══════════════════════════════════════════════════════════════════════════
// DAILY DATA
// ═══════════════════════════════════════════════════════════════════════════

d_ema8     = request.security(syminfo.tickerid, "D", ta.ema(close, 8),  lookahead=barmerge.lookahead_off)
d_ema21    = request.security(syminfo.tickerid, "D", ta.ema(close, 21), lookahead=barmerge.lookahead_off)
d_atr5     = request.security(syminfo.tickerid, "D", ta.atr(5),         lookahead=barmerge.lookahead_off)
d_atr20    = request.security(syminfo.tickerid, "D", ta.atr(20),        lookahead=barmerge.lookahead_off)
d_prev_cls = request.security(syminfo.tickerid, "D", close[1],          lookahead=barmerge.lookahead_off)
d_open     = request.security(syminfo.tickerid, "D", open,              lookahead=barmerge.lookahead_off)
d_vix      = request.security(vix_sym,          "D", close,             lookahead=barmerge.lookahead_off)

// Adaptive ATR: max(5-day, 20-day)
atr_adapt = math.max(nz(d_atr5, 200.0), nz(d_atr20, 200.0))

// ═══════════════════════════════════════════════════════════════════════════
// REGIME CLASSIFICATION
// ═══════════════════════════════════════════════════════════════════════════

ema_spread = nz(d_ema21, 1) > 0 ? (nz(d_ema8) - nz(d_ema21)) / nz(d_ema21) * 100 : 0.0

trend_dir = (ema_spread > ema_strong  ? "STRONG BULL" :
             ema_spread > ema_mild    ? "bull"         :
             ema_spread < -ema_strong ? "STRONG BEAR"  :
             ema_spread < -ema_mild   ? "bear"         : "neutral")

vix_now    = nz(d_vix, 18.0)
vix_regime = (vix_now >= 35 ? "CRISIS" :
              vix_now >= 22 ? "ELEVATED" :
              vix_now >= 15 ? "NORMAL" : "LOW")

vix_ok = vix_now < vix_elev

trend_bull        = str.contains(trend_dir, "BULL") or trend_dir == "bull"
trend_bear        = str.contains(trend_dir, "BEAR") or trend_dir == "bear"
trend_strong_bull = trend_dir == "STRONG BULL"
trend_strong_bear = trend_dir == "STRONG BEAR"
trend_neutral     = trend_dir == "neutral"

// ORB: strong trend + neutral only (83%+ WR in those regimes)
orb_long_regime  = vix_ok and (trend_strong_bull or trend_neutral)
orb_short_regime = vix_ok and trend_strong_bear

// FVG / IB / VWAP: neutral markets only
mean_rev_regime = vix_ok and trend_neutral

// Gap Fill direction gates
gap_long_ok  = not trend_bear and not trend_strong_bear
gap_short_ok = trend_neutral or trend_bear or trend_strong_bear

// ═══════════════════════════════════════════════════════════════════════════
// SESSION / TIME DETECTION (ET)
// ═══════════════════════════════════════════════════════════════════════════

ET = "America/New_York"

in_rth   = not na(time(timeframe.period, "0930-1200", ET))
bar_hr   = hour(time, ET)
bar_min  = minute(time, ET)
bar_mins = bar_hr * 60 + bar_min

is_930      = in_rth and bar_hr == 9 and bar_min == 30
is_in_ib    = in_rth and bar_mins < 600
is_c_period = in_rth and bar_mins >= 600 and bar_mins < 630

new_day = ta.change(time("D")) != 0

var int rth_start_idx = na
var int ib_end_idx    = na
if is_930
    rth_start_idx := bar_index
if is_in_ib
    ib_end_idx := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// SESSION VWAP + 2-SIGMA BANDS
// ═══════════════════════════════════════════════════════════════════════════

var float cum_tp_vol = na
var float cum_volume = na
var float cum_sq_dev = na
var int   vwap_bars  = 0

if new_day or na(cum_tp_vol)
    cum_tp_vol := 0.0
    cum_volume := 0.0
    cum_sq_dev := 0.0
    vwap_bars  := 0

if in_rth and volume > 0
    tp = (high + low + close) / 3.0
    cum_tp_vol += tp * volume
    cum_volume += volume
    vwap_bars  += 1

vwap_val = cum_volume > 0 ? cum_tp_vol / cum_volume : close

if in_rth and vwap_bars > 1
    cum_sq_dev += math.pow(close - vwap_val, 2)

rolling_std = vwap_bars > 1 ? math.sqrt(cum_sq_dev / math.max(vwap_bars - 1, 1)) : 0.0
vwap_upper  = vwap_val + 2.0 * rolling_std
vwap_lower  = vwap_val - 2.0 * rolling_std

// ═══════════════════════════════════════════════════════════════════════════
// GAP FILL DETECTION
// ═══════════════════════════════════════════════════════════════════════════

gap_pts   = nz(d_open) - nz(d_prev_cls)
gap_size  = math.abs(gap_pts)
gap_pct   = nz(d_prev_cls) > 0 ? gap_size / nz(d_prev_cls) : 0.0
gap_ratio = atr_adapt > 0 ? gap_size / atr_adapt : 0.0

gap_valid = gap_size >= 2.0 and gap_ratio < 0.30 and gap_pct < 0.0055

first_bar_bullish = close[1] > open[1]
first_bar_bearish = close[1] < open[1]
prev_was_930      = is_930[1]

gap_long  = prev_was_930 and gap_valid[1] and gap_pts[1] < 0 and first_bar_bullish and gap_long_ok
gap_short = prev_was_930 and gap_valid[1] and gap_pts[1] > 0 and first_bar_bearish and gap_short_ok

// ═══════════════════════════════════════════════════════════════════════════
// ORB (Opening Range Breakout)
// ═══════════════════════════════════════════════════════════════════════════

var float orb_hi   = na
var float orb_lo   = na
var bool  orb_done = false
var box   orb_box  = na

if is_930
    orb_hi   := high
    orb_lo   := low
    orb_done := false
    if show_orb and not na(orb_box)
        box.delete(orb_box)
    if show_orb
        orb_box := box.new(bar_index, orb_hi, bar_index + 80, orb_lo,
             border_color=color.blue, border_width=1, border_style=line.style_dashed,
             bgcolor=color.new(color.blue, 90))

if show_orb and not na(orb_box) and not is_930
    box.set_right(orb_box, bar_index + 10)

orb_range   = nz(orb_hi) - nz(orb_lo)
orb_ok_size = (atr_adapt > 0 and
               orb_range >= math.max(3.0, atr_adapt * orb_min_atr) and
               orb_range <= atr_adapt * orb_max_atr)

dow = dayofweek
orb_not_mon_tue_long = dow != dayofweek.monday and dow != dayofweek.tuesday

orb_long_sig = (not orb_done and in_rth and not is_in_ib and
                not na(orb_hi) and orb_ok_size and orb_long_regime and
                close > orb_hi and close > vwap_val and orb_not_mon_tue_long)

orb_short_sig = (not orb_done and in_rth and not is_in_ib and
                 not na(orb_lo) and orb_ok_size and orb_short_regime and
                 close < orb_lo and close < vwap_val)

if orb_long_sig or orb_short_sig
    orb_done := true

// ═══════════════════════════════════════════════════════════════════════════
// IB BREAKOUT (Initial Balance: 9:30-10:00 ET)
// ═══════════════════════════════════════════════════════════════════════════

var float  ib_hi        = na
var float  ib_lo        = na
var int    ib_hi_idx    = 0
var int    ib_lo_idx    = 0
var bool   ib_done      = false
var bool   ib_box_drawn = false
var box    ib_box       = na
var string ib_bias      = ""

if new_day
    ib_hi        := na
    ib_lo        := na
    ib_done      := false
    ib_box_drawn := false
    ib_bias      := ""
    if show_ib and not na(ib_box)
        box.delete(ib_box)
        ib_box := na

if is_in_ib
    if na(ib_hi) or high > ib_hi
        ib_hi     := high
        ib_hi_idx := bar_index
    if na(ib_lo) or low < ib_lo
        ib_lo     := low
        ib_lo_idx := bar_index

if not ib_box_drawn and not is_in_ib and in_rth and not na(ib_hi) and not na(rth_start_idx)
    ib_bias      := ib_hi_idx <= ib_lo_idx ? "bearish" : "bullish"
    ib_box_drawn := true
    if show_ib
        ib_box := box.new(rth_start_idx, ib_hi, bar_index + 80, ib_lo,
             border_color=color.purple, border_width=1, border_style=line.style_dashed,
             bgcolor=color.new(color.purple, 92))

if show_ib and not na(ib_box)
    box.set_right(ib_box, bar_index + 10)

ib_range   = nz(ib_hi) - nz(ib_lo)
ib_ok_size = (atr_adapt > 0 and
              ib_range >= math.max(5.0, atr_adapt * ib_min_atr) and
              ib_range <= atr_adapt * ib_max_atr)

ib_long_sig = (not ib_done and is_c_period and not na(ib_hi) and ib_ok_size and
               mean_rev_regime and ib_bias == "bullish" and
               close > ib_hi and (close - ib_hi) <= 20.0)

ib_short_sig = (not ib_done and is_c_period and not na(ib_lo) and ib_ok_size and
                mean_rev_regime and ib_bias == "bearish" and
                close < ib_lo and (ib_lo - close) <= 20.0)

if ib_long_sig or ib_short_sig
    ib_done := true

// ═══════════════════════════════════════════════════════════════════════════
// VWAP REVERSION SIGNALS (neutral trend only)
// ═══════════════════════════════════════════════════════════════════════════

var bool vwap_l_done = false
var bool vwap_s_done = false

if new_day
    vwap_l_done := false
    vwap_s_done := false

vwap_min_dev   = math.max(5.0, atr_adapt * 0.025)
vwap_max_dev   = math.min(50.0, atr_adapt * 0.18)
vwap_dev       = math.abs(close - vwap_val)
vwap_in_window = in_rth and bar_mins >= 585 and bar_mins < 690

vwap_long_sig = (not vwap_l_done and vwap_in_window and mean_rev_regime and
                 close < vwap_lower and vwap_dev >= vwap_min_dev and vwap_dev <= vwap_max_dev)

vwap_short_sig = (not vwap_s_done and vwap_in_window and mean_rev_regime and
                  close > vwap_upper and vwap_dev >= vwap_min_dev and vwap_dev <= vwap_max_dev)

if vwap_long_sig
    vwap_l_done := true
if vwap_short_sig
    vwap_s_done := true

// ═══════════════════════════════════════════════════════════════════════════
// FVG ZONE DETECTION (neutral + VIX ok + 9:45-11:30)
// ═══════════════════════════════════════════════════════════════════════════

fvg_window = in_rth and bar_mins >= 585 and bar_mins < 690
fvg_regime = mean_rev_regime and fvg_window
fvg_min_sz = math.max(6.0, atr_adapt * 0.04)
fvg_max_sz = atr_adapt * 0.15

bull_fvg_sz = low - high[2]
bull_fvg_ok = fvg_regime and bull_fvg_sz >= fvg_min_sz and bull_fvg_sz <= fvg_max_sz

bear_fvg_sz = low[2] - high
bear_fvg_ok = fvg_regime and bear_fvg_sz >= fvg_min_sz and bear_fvg_sz <= fvg_max_sz

if show_fvg and bull_fvg_ok
    box.new(bar_index - 2, low, bar_index + 25, high[2],
         border_color=color.new(color.lime, 30), border_width=1,
         bgcolor=color.new(color.lime, 82))

if show_fvg and bear_fvg_ok
    box.new(bar_index - 2, low[2], bar_index + 25, high,
         border_color=color.new(color.red, 30), border_width=1,
         bgcolor=color.new(color.red, 82))

// ═══════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════

plot(show_vwap and in_rth ? vwap_val   : na, "VWAP",     color=color.orange,                linewidth=2)
plot(show_vwap and in_rth ? vwap_upper : na, "VWAP+2sd", color=color.new(color.orange, 45), linewidth=1)
plot(show_vwap and in_rth ? vwap_lower : na, "VWAP-2sd", color=color.new(color.orange, 45), linewidth=1)

bgcolor(shade_rth and in_rth ? color.new(color.blue, 97) : na, title="Trade Window")

if show_prev and is_930 and not na(d_prev_cls)
    line.new(bar_index, d_prev_cls, bar_index + 90, d_prev_cls,
         color=color.new(color.gray, 20), width=1, style=line.style_dashed)

// ═══════════════════════════════════════════════════════════════════════════
// SIGNAL LABELS
// ═══════════════════════════════════════════════════════════════════════════

if show_sigs
    if gap_long
        entry_p = open
        stop_p  = low[1] - 2.0
        tgt_p   = nz(d_prev_cls)
        label.new(bar_index, low - atr_adapt * 0.015,
             "GAP FILL LONG\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\n" + str.tostring(gap_size[1], "#.1") + "pt gap",
             color=color.new(color.green, 15), textcolor=color.white,
             style=label.style_label_up, size=size.small)

    if gap_short
        entry_p = open
        stop_p  = high[1] + 2.0
        tgt_p   = nz(d_prev_cls)
        label.new(bar_index, high + atr_adapt * 0.015,
             "GAP FILL SHORT\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\n" + str.tostring(gap_size[1], "#.1") + "pt gap",
             color=color.new(color.maroon, 15), textcolor=color.white,
             style=label.style_label_down, size=size.small)

    if orb_long_sig
        entry_p = close
        stop_p  = math.max(orb_hi - orb_range * 0.5, entry_p - 25)
        tgt_p   = entry_p + orb_range
        label.new(bar_index, high + atr_adapt * 0.01,
             "ORB LONG  [" + trend_dir + "]\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\nORB=" + str.tostring(orb_range, "#.0") + "pt  ATR=" + str.tostring(atr_adapt, "#.0"),
             color=color.new(color.blue, 10), textcolor=color.white,
             style=label.style_label_down, size=size.small)

    if orb_short_sig
        entry_p = close
        stop_p  = math.min(orb_lo + orb_range * 0.5, entry_p + 25)
        tgt_p   = entry_p - orb_range
        label.new(bar_index, low - atr_adapt * 0.01,
             "ORB SHORT  [" + trend_dir + "]\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\nORB=" + str.tostring(orb_range, "#.0") + "pt",
             color=color.new(color.red, 10), textcolor=color.white,
             style=label.style_label_up, size=size.small)

    if ib_long_sig
        entry_p = close
        stop_p  = ib_hi - 2.0
        tgt_p   = ib_hi + ib_range * 0.75
        label.new(bar_index, high + atr_adapt * 0.01,
             "IB BREAKOUT LONG  [" + ib_bias + "]\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\nIB=" + str.tostring(ib_range, "#.0") + "pt",
             color=color.new(color.purple, 10), textcolor=color.white,
             style=label.style_label_down, size=size.small)

    if ib_short_sig
        entry_p = close
        stop_p  = ib_lo + 2.0
        tgt_p   = ib_lo - ib_range * 0.75
        label.new(bar_index, low - atr_adapt * 0.01,
             "IB BREAKOUT SHORT  [" + ib_bias + "]\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\nIB=" + str.tostring(ib_range, "#.0") + "pt",
             color=color.new(color.purple, 10), textcolor=color.white,
             style=label.style_label_up, size=size.small)

    if vwap_long_sig
        entry_p   = close
        stop_dist = math.max(8.0, atr_adapt * 0.06)
        stop_p    = entry_p - stop_dist
        tgt_p     = vwap_val
        label.new(bar_index, low - atr_adapt * 0.01,
             "VWAP REV LONG\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\ndev=" + str.tostring(vwap_dev, "#.0") + "pt (-2sd)",
             color=color.new(color.teal, 10), textcolor=color.white,
             style=label.style_label_up, size=size.small)

    if vwap_short_sig
        entry_p   = close
        stop_dist = math.max(8.0, atr_adapt * 0.06)
        stop_p    = entry_p + stop_dist
        tgt_p     = vwap_val
        label.new(bar_index, high + atr_adapt * 0.01,
             "VWAP REV SHORT\nE:" + str.tostring(entry_p, "#.0") +
             "  S:" + str.tostring(stop_p, "#.0") +
             "  T:" + str.tostring(tgt_p, "#.0") +
             "\ndev=" + str.tostring(vwap_dev, "#.0") + "pt (+2sd)",
             color=color.new(color.teal, 10), textcolor=color.white,
             style=label.style_label_down, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// REGIME DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 9,
     border_width=1, border_color=color.new(color.gray, 60),
     frame_width=2,  frame_color=color.new(color.gray, 40))

c_header = color.new(#1a237e, 0)
c_key    = color.new(color.gray, 40)
c_green  = color.new(#1b5e20, 10)
c_red    = color.new(#b71c1c, 10)
c_orange = color.new(#e65100, 10)
c_gray   = color.new(color.gray, 60)

trend_col = (trend_strong_bull ? c_green :
             trend_bull        ? color.new(color.green, 30) :
             trend_neutral     ? c_gray :
             trend_bear        ? color.new(color.orange, 30) :
             trend_strong_bear ? c_red : c_gray)

vix_col = (vix_now < 15 ? c_green :
           vix_now < 22 ? color.new(color.green, 30) :
           vix_now < 35 ? c_orange : c_red)

if show_dash and barstate.islast
    table.cell(dash, 0, 0, "QUANT SYSTEM",      text_color=color.white, bgcolor=c_header, text_size=size.small)
    table.cell(dash, 1, 0, "NQ / MNQ  $50 max", text_color=color.white, bgcolor=c_header, text_size=size.small)

    table.cell(dash, 0, 1, "Trend", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 1, trend_dir + "  (" + str.tostring(ema_spread, "#.1") + "%)",
         text_color=color.white, bgcolor=trend_col, text_size=size.small)

    table.cell(dash, 0, 2, "VIX", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(vix_now, "#.1") + "  [" + vix_regime + "]",
         text_color=color.white, bgcolor=vix_col, text_size=size.small)

    table.cell(dash, 0, 3, "ATR (adaptive)", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(atr_adapt, "#.0") + " pts",
         text_color=color.white, bgcolor=c_header, text_size=size.small)

    table.cell(dash, 0, 4, "Gap Fill", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 4, gap_long_ok ? "ACTIVE   58% WR" : "off",
         text_color=color.white, bgcolor=gap_long_ok ? c_green : c_gray, text_size=size.small)

    table.cell(dash, 0, 5, "ORB (5m)", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 5, orb_long_regime ? "ACTIVE   83% WR" : orb_short_regime ? "SHORT active" : "off",
         text_color=color.white, bgcolor=(orb_long_regime or orb_short_regime) ? c_green : c_gray, text_size=size.small)

    table.cell(dash, 0, 6, "FVG / IB / VWAP", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 6, mean_rev_regime ? "ACTIVE (neutral)" : "off (need neutral)",
         text_color=color.white, bgcolor=mean_rev_regime ? c_green : c_gray, text_size=size.small)

    ib_bias_txt = (ib_bias == "" ? "building..." :
                   ib_bias == "bullish" ? "bullish (long bias)" : "bearish (short bias)")
    table.cell(dash, 0, 7, "IB Bias", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 7, ib_bias_txt,
         text_color=color.white,
         bgcolor=(ib_bias == "bullish" ? color.new(color.green, 40) :
                  ib_bias == "bearish" ? color.new(color.red, 40) : c_gray),
         text_size=size.small)

    table.cell(dash, 0, 8, "Risk limit", text_color=color.white, bgcolor=c_key, text_size=size.small)
    table.cell(dash, 1, 8, "25 pts = $50 / 1 MNQ",
         text_color=color.white, bgcolor=c_header, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════

alertcondition(gap_long,       title="Gap Fill LONG",          message="GAP FILL LONG — tiny gap-down confirmed. Enter next bar open, target prior close.")
alertcondition(gap_short,      title="Gap Fill SHORT",         message="GAP FILL SHORT — tiny gap-up confirmed. Enter next bar open, target prior close.")
alertcondition(orb_long_sig,   title="ORB LONG",               message="ORB BREAKOUT LONG — close above ORB high + VWAP, strong bull trend. Enter next bar open.")
alertcondition(orb_short_sig,  title="ORB SHORT",              message="ORB BREAKOUT SHORT — close below ORB low + VWAP, strong bear trend. Enter next bar open.")
alertcondition(ib_long_sig,    title="IB Breakout LONG",       message="IB BREAKOUT LONG — C-period, bullish bias, neutral trend. Enter next bar open.")
alertcondition(ib_short_sig,   title="IB Breakout SHORT",      message="IB BREAKOUT SHORT — C-period, bearish bias, neutral trend. Enter next bar open.")
alertcondition(vwap_long_sig,  title="VWAP Rev LONG",          message="VWAP REVERSION LONG — price at -2sd, neutral trend. Enter next bar, target VWAP.")
alertcondition(vwap_short_sig, title="VWAP Rev SHORT",         message="VWAP REVERSION SHORT — price at +2sd, neutral trend. Enter next bar, target VWAP.")
alertcondition(bull_fvg_ok,    title="Bullish FVG Detected",   message="Bullish FVG formed — watch for price to return and test zone.")
alertcondition(bear_fvg_ok,    title="Bearish FVG Detected",   message="Bearish FVG formed — watch for price to return and test zone.")
