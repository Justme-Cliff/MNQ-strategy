//@version=5
indicator("TJR Asia Sweep System v2 - MNQ", overlay=true,
     max_boxes_count=100, max_labels_count=200, max_lines_count=100)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
var g_core  = "Core Settings"
min_score   = input.int(4,    "Min Score to Alert (1-7)", minval=1, maxval=7, group=g_core)
pivot_str   = input.int(2,    "MSS Pivot Strength",       minval=1, maxval=5, group=g_core)
fvg_min     = input.float(2.0,"Min FVG Size (pts)",       minval=0.25,        group=g_core)
ob_min_body = input.float(3.0,"Min OB Body (pts)",        minval=0.5,         group=g_core)

var g_vis   = "Display"
show_asia   = input.bool(true,  "Show Asia Range",              group=g_vis)
show_london = input.bool(true,  "Show London Sweep Labels",     group=g_vis)
show_pdhl   = input.bool(true,  "Show Prev Day H/L",            group=g_vis)
show_or     = input.bool(true,  "Show Opening Range 9:30-10",   group=g_vis)
show_fvg    = input.bool(true,  "Show FVG Zones",               group=g_vis)
show_ob     = input.bool(true,  "Show Order Block Zones",       group=g_vis)
show_vwap   = input.bool(true,  "Show VWAP",                    group=g_vis)
show_score  = input.bool(true,  "Show Score Labels",            group=g_vis)
show_dow    = input.bool(true,  "Show Day-of-Week Label",       group=g_vis)
show_sweep  = input.bool(true,  "Show Sweep / MSS Labels",      group=g_vis)
show_bg     = input.bool(true,  "Shade Trade Window",           group=g_vis)

var g_thr   = "Day Thresholds (min score)"
min_mon = input.int(4, "Monday",    minval=4, maxval=7, group=g_thr)
min_tue = input.int(7, "Tuesday",   minval=4, maxval=7, group=g_thr)
min_wed = input.int(4, "Wednesday", minval=4, maxval=7, group=g_thr)
min_thu = input.int(5, "Thursday",  minval=4, maxval=7, group=g_thr)
min_fri = input.int(4, "Friday",    minval=4, maxval=7, group=g_thr)

// ═══════════════════════════════════════════════════════════════════════════════
// DISPLACEMENT STRENGTH — calculated every bar unconditionally
// Pine Script requires series functions to run on every bar, not inside if blocks
// ═══════════════════════════════════════════════════════════════════════════════
bar_range      = math.max(high - low, 0.01)
bar_body       = math.abs(close - open)
bar_body_ratio = bar_body / bar_range
avg_range      = math.max(ta.sma(high - low, 10), 0.01)
bar_rel_size   = bar_range / avg_range
bar_is_strong  = bar_body_ratio >= 0.55 and bar_rel_size >= 1.3

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════════════
in_asia   = not na(time("", "2000-0000", "America/New_York"))
in_london = not na(time("", "0200-0800", "America/New_York"))
in_trade  = not na(time("", "0930-1130", "America/New_York"))
in_prime  = not na(time("", "0930-1100", "America/New_York"))
in_or     = not na(time("", "0930-1000", "America/New_York"))
new_day   = ta.change(dayofmonth) != 0
dow       = dayofweek  // 1=Sun 2=Mon 3=Tue 4=Wed 5=Thu 6=Fri 7=Sat

// ═══════════════════════════════════════════════════════════════════════════════
// ASIA RANGE
// ═══════════════════════════════════════════════════════════════════════════════
var float asia_hi  = na
var float asia_lo  = na
var float today_hi = na
var float today_lo = na

if new_day
    today_hi := asia_hi
    today_lo := asia_lo
    asia_hi  := na
    asia_lo  := na

if in_asia
    asia_hi := na(asia_hi) ? high : math.max(asia_hi, high)
    asia_lo := na(asia_lo) ? low  : math.min(asia_lo, low)

plot(show_asia and not na(today_hi) ? today_hi : na, "Asia High",
     color=color.orange, linewidth=2, style=plot.style_linebr)
plot(show_asia and not na(today_lo) ? today_lo : na, "Asia Low",
     color=color.orange, linewidth=2, style=plot.style_linebr)

var label asia_range_lbl = na
if show_asia and in_trade and not in_trade[1] and not na(today_hi) and not na(today_lo)
    label.delete(asia_range_lbl)
    asia_range_lbl := label.new(bar_index, today_hi, "Asia: " + str.tostring(math.round(today_hi - today_lo, 1)) + " pts", color=color.new(color.orange, 75), textcolor=color.orange, style=label.style_label_lower_right, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// PREVIOUS DAY HIGH / LOW
// ═══════════════════════════════════════════════════════════════════════════════
var float pdh         = na
var float pdl         = na
var float running_hi  = na
var float running_lo  = na

if new_day
    if not na(running_hi)
        pdh := running_hi
        pdl := running_lo
    running_hi := high
    running_lo := low
else
    if not na(time("", "0930-1600", "America/New_York"))
        running_hi := na(running_hi) ? high : math.max(running_hi, high)
        running_lo := na(running_lo) ? low  : math.min(running_lo, low)

plot(show_pdhl and not na(pdh) ? pdh : na, "PDH", color=color.new(color.gray, 40), linewidth=1, style=plot.style_linebr)
plot(show_pdhl and not na(pdl) ? pdl : na, "PDL", color=color.new(color.gray, 40), linewidth=1, style=plot.style_linebr)

var bool pdhl_labeled = false
if new_day
    pdhl_labeled := false
if show_pdhl and in_trade and not in_trade[1] and not na(pdh) and not pdhl_labeled
    pdhl_labeled := true
    label.new(bar_index, pdh, "PDH " + str.tostring(math.round(pdh, 1)), color=color.new(color.gray, 80), textcolor=color.new(color.gray, 20), style=label.style_label_lower_right, size=size.tiny)
    label.new(bar_index, pdl, "PDL " + str.tostring(math.round(pdl, 1)), color=color.new(color.gray, 80), textcolor=color.new(color.gray, 20), style=label.style_label_upper_right, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// LONDON SWEEP DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
var bool   london_swept_hi = false
var bool   london_swept_lo = false
var string london_dir      = "neutral"
var bool   london_dir_set  = false
var bool   lond_hi_lbl     = false
var bool   lond_lo_lbl     = false

if new_day
    london_swept_hi := false
    london_swept_lo := false
    london_dir      := "neutral"
    london_dir_set  := false
    lond_hi_lbl     := false
    lond_lo_lbl     := false

if in_london and not na(today_hi)
    if high > today_hi
        london_swept_hi := true
    if low < today_lo
        london_swept_lo := true

if in_trade and not in_trade[1] and not london_dir_set
    london_dir_set := true
    if london_swept_lo and not london_swept_hi
        london_dir := "bullish"
    else if london_swept_hi and not london_swept_lo
        london_dir := "bearish"
    else if london_swept_hi and london_swept_lo
        london_dir := "both"
    else
        london_dir := "neutral"
    if show_london
        ld_col = london_dir == "bullish" ? color.green : london_dir == "bearish" ? color.red : london_dir == "both" ? color.orange : color.gray
        ld_txt = london_dir == "bullish" ? "London BULL - swept Asia Low" : london_dir == "bearish" ? "London BEAR - swept Asia High" : london_dir == "both" ? "London BOTH - unclear" : "London NEUTRAL"
        label.new(bar_index, na(today_hi) ? high : today_hi, ld_txt, color=color.new(ld_col, 75), textcolor=ld_col, style=label.style_label_right, size=size.small)

if show_london and in_london and not na(today_hi) and high > today_hi and not lond_hi_lbl
    lond_hi_lbl := true
    label.new(bar_index, high, "LDN HI +" + str.tostring(math.round(high - today_hi, 1)), color=color.new(color.red, 60), textcolor=color.red, style=label.style_label_down, size=size.small)

if show_london and in_london and not na(today_lo) and low < today_lo and not lond_lo_lbl
    lond_lo_lbl := true
    label.new(bar_index, low, "LDN LO -" + str.tostring(math.round(today_lo - low, 1)), color=color.new(color.green, 60), textcolor=color.green, style=label.style_label_up, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// OPENING RANGE  9:30 to 10:00 AM
// ═══════════════════════════════════════════════════════════════════════════════
var float  or_hi   = na
var float  or_lo   = na
var float  or_open = na
var bool   or_done = false
var string or_dir  = "neutral"
var box    or_box  = na

if new_day
    or_hi   := na
    or_lo   := na
    or_open := na
    or_done := false
    or_dir  := "neutral"

if in_or
    if na(or_open)
        or_open := open
    or_hi := na(or_hi) ? high : math.max(or_hi, high)
    or_lo := na(or_lo) ? low  : math.min(or_lo, low)

if not in_or and in_or[1] and not or_done and not na(or_open)
    or_done := true
    or_dir  := close >= or_open ? "bullish" : "bearish"

if show_or and in_or and not in_or[1]
    or_box := box.new(bar_index, na(or_hi) ? high : or_hi, bar_index, na(or_lo) ? low : or_lo, border_color=color.new(color.yellow, 50), bgcolor=color.new(color.yellow, 92), extend=extend.right, border_width=1)

if show_or and or_done and not or_done[1] and not na(or_box)
    box.set_right(or_box, bar_index)
    box.set_extend(or_box, extend.none)

plot(show_or and or_done and not na(or_hi) ? or_hi : na, "OR High", color=color.new(color.yellow, 60), linewidth=1, style=plot.style_linebr)
plot(show_or and or_done and not na(or_lo) ? or_lo : na, "OR Low",  color=color.new(color.yellow, 60), linewidth=1, style=plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════════════════
// VWAP
// ═══════════════════════════════════════════════════════════════════════════════
[vwap_val, _, _] = ta.vwap(high, low, close)
plot(show_vwap ? vwap_val : na, "VWAP", color=color.new(color.yellow, 20), linewidth=2)

// ═══════════════════════════════════════════════════════════════════════════════
// SWEEP DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
var bool  bull_sweep       = false
var bool  bear_sweep       = false
var int   bull_sweep_bar   = na
var int   bear_sweep_bar   = na
var float bull_sweep_px    = na
var float bear_sweep_px    = na
var float bull_sweep_depth = 0.0
var float bear_sweep_depth = 0.0

if new_day
    bull_sweep       := false
    bear_sweep       := false
    bull_sweep_bar   := na
    bear_sweep_bar   := na
    bull_sweep_px    := na
    bear_sweep_px    := na
    bull_sweep_depth := 0.0
    bear_sweep_depth := 0.0

if in_trade and not na(today_lo) and low < today_lo and not bull_sweep
    _depth = math.round(today_lo - low, 2)
    if _depth >= 8.0 and _depth <= 80.0
        bull_sweep       := true
        bull_sweep_bar   := bar_index
        bull_sweep_px    := low
        bull_sweep_depth := _depth
        if show_sweep
            label.new(bar_index, low, "SWEEP LOW\n-" + str.tostring(_depth) + " pts", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

if in_trade and not na(today_hi) and high > today_hi and not bear_sweep
    _depth = math.round(high - today_hi, 2)
    if _depth >= 8.0 and _depth <= 80.0
        bear_sweep       := true
        bear_sweep_bar   := bar_index
        bear_sweep_px    := high
        bear_sweep_depth := _depth
        if show_sweep
            label.new(bar_index, high, "SWEEP HIGH\n+" + str.tostring(_depth) + " pts", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// MSS DETECTION  (uses bar_is_strong calculated unconditionally above)
// ═══════════════════════════════════════════════════════════════════════════════
swing_hi = ta.pivothigh(high, pivot_str, pivot_str)
swing_lo = ta.pivotlow(low,  pivot_str, pivot_str)

var float track_hi        = na
var float track_lo        = na
var bool  bull_mss        = false
var bool  bear_mss        = false
var bool  bull_mss_strong = false
var bool  bear_mss_strong = false

if new_day
    track_hi        := na
    track_lo        := na
    bull_mss        := false
    bear_mss        := false
    bull_mss_strong := false
    bear_mss_strong := false

if not na(swing_hi) and in_trade
    track_hi := na(track_hi) ? swing_hi : math.max(track_hi, swing_hi)
if not na(swing_lo) and in_trade
    track_lo := na(track_lo) ? swing_lo : math.min(track_lo, swing_lo)

if bull_sweep and not bull_mss and not na(track_hi) and close > track_hi
    bull_mss        := true
    bull_mss_strong := bar_is_strong
    if show_sweep
        _mss_col = bull_mss_strong ? color.lime : color.new(color.green, 40)
        _txt     = bull_mss_strong ? "MSS UP  STRONG" : "MSS UP  weak"
        label.new(bar_index, low, _txt, color=color.new(_mss_col, 20), textcolor=color.black, style=label.style_label_up, size=size.normal)

if bear_sweep and not bear_mss and not na(track_lo) and close < track_lo
    bear_mss        := true
    bear_mss_strong := bar_is_strong
    if show_sweep
        _mss_col = bear_mss_strong ? color.red : color.new(color.red, 40)
        _txt     = bear_mss_strong ? "MSS DOWN  STRONG" : "MSS DOWN  weak"
        label.new(bar_index, high, _txt, color=color.new(_mss_col, 20), textcolor=color.white, style=label.style_label_down, size=size.normal)

// ═══════════════════════════════════════════════════════════════════════════════
// FVG DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
bull_fvg_sig = bull_sweep and high[2] < low  and (low  - high[2]) >= fvg_min
bear_fvg_sig = bear_sweep and low[2]  > high and (low[2] - high)  >= fvg_min

var float bfvg_top = na
var float bfvg_bot = na
var float sfvg_top = na
var float sfvg_bot = na

if new_day
    bfvg_top := na
    bfvg_bot := na
    sfvg_top := na
    sfvg_bot := na

if bull_fvg_sig
    bfvg_top := low
    bfvg_bot := high[2]
    if show_fvg
        box.new(bar_index - 2, low, bar_index + 20, high[2], border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 88), extend=extend.right)

if bear_fvg_sig
    sfvg_top := low[2]
    sfvg_bot := high
    if show_fvg
        box.new(bar_index - 2, low[2], bar_index + 20, high, border_color=color.new(color.red, 20), bgcolor=color.new(color.red, 88), extend=extend.right)

in_bfvg = not na(bfvg_bot) and close >= bfvg_bot and close <= bfvg_top
in_sfvg = not na(sfvg_bot) and close >= sfvg_bot and close <= sfvg_top

// ═══════════════════════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
var float bull_ob_top  = na
var float bull_ob_bot  = na
var float bull_ob_stop = na
var float bear_ob_top  = na
var float bear_ob_bot  = na
var float bear_ob_stop = na

if new_day
    bull_ob_top  := na
    bull_ob_bot  := na
    bull_ob_stop := na
    bear_ob_top  := na
    bear_ob_bot  := na
    bear_ob_stop := na

if bull_mss and not bull_mss[1]
    for i = 1 to math.min(20, bar_index)
        _o = open[i]
        _c = close[i]
        if _c < _o and (_o - _c) >= ob_min_body
            bull_ob_top  := _o
            bull_ob_bot  := _c
            bull_ob_stop := low[i] - 1.0
            if show_ob
                box.new(bar_index - i, _o, bar_index + 30, _c, border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 82), border_width=2, extend=extend.right)
                label.new(bar_index - i, _o, "OB", color=color.new(color.green, 40), textcolor=color.green, style=label.style_label_lower_right, size=size.tiny)
            break

if bear_mss and not bear_mss[1]
    for i = 1 to math.min(20, bar_index)
        _o = open[i]
        _c = close[i]
        if _c > _o and (_c - _o) >= ob_min_body
            bear_ob_top  := _c
            bear_ob_bot  := _o
            bear_ob_stop := high[i] + 1.0
            if show_ob
                box.new(bar_index - i, _c, bar_index + 30, _o, border_color=color.new(color.red, 30), bgcolor=color.new(color.red, 82), border_width=2, extend=extend.right)
                label.new(bar_index - i, _c, "OB", color=color.new(color.red, 40), textcolor=color.red, style=label.style_label_upper_right, size=size.tiny)
            break

// ═══════════════════════════════════════════════════════════════════════════════
// PDH/PDL CONFLUENCE  +  OPENING RANGE OPPOSITION
// ═══════════════════════════════════════════════════════════════════════════════
bull_pdl_conf  = bull_sweep and not na(pdl) and bull_sweep_px <= pdl
bear_pdh_conf  = bear_sweep and not na(pdh) and bear_sweep_px >= pdh
bull_or_opp    = bull_mss and or_dir == "bearish"
bear_or_opp    = bear_mss and or_dir == "bullish"

// ═══════════════════════════════════════════════════════════════════════════════
// 7-POINT CONFLUENCE SCORING
// ═══════════════════════════════════════════════════════════════════════════════
lp1 = bull_sweep       ? 1 : 0
lp2 = bull_mss         ? 1 : 0
lp3 = in_bfvg          ? 1 : 0
lp4 = close < vwap_val ? 1 : 0
lp5 = in_prime         ? 1 : 0
lp6 = bull_pdl_conf    ? 1 : 0
lp7 = bull_or_opp      ? 1 : 0

sp1 = bear_sweep       ? 1 : 0
sp2 = bear_mss         ? 1 : 0
sp3 = in_sfvg          ? 1 : 0
sp4 = close > vwap_val ? 1 : 0
sp5 = in_prime         ? 1 : 0
sp6 = bear_pdh_conf    ? 1 : 0
sp7 = bear_or_opp      ? 1 : 0

long_score  = lp1 + lp2 + lp3 + lp4 + lp5 + lp6 + lp7
short_score = sp1 + sp2 + sp3 + sp4 + sp5 + sp6 + sp7

// Penalty: +1 required when London opposes or MSS is weak
long_base  = not (london_dir == "bullish" or london_dir == "neutral") or not bull_mss_strong ? min_score + 1 : min_score
short_base = not (london_dir == "bearish" or london_dir == "neutral") or not bear_mss_strong ? min_score + 1 : min_score

// Day-of-week minimum
dow_min = dow == 2 ? min_mon : dow == 3 ? min_tue : dow == 4 ? min_wed : dow == 5 ? min_thu : dow == 6 ? min_fri : min_score

long_req  = math.max(long_base,  dow_min)
short_req = math.max(short_base, dow_min)

long_signal  = bull_mss and long_score  >= long_req  and in_trade
short_signal = bear_mss and short_score >= short_req and in_trade

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY / STOP / TARGETS
// ═══════════════════════════════════════════════════════════════════════════════
long_entry = not na(bull_ob_top)  ? bull_ob_top  : (na(today_lo) ? close : today_lo + 1.0)
long_stop  = not na(bull_ob_stop) ? bull_ob_stop : (na(today_lo) ? close - 25 : today_lo - 25.0)
long_risk  = math.max(long_entry - long_stop, 0.25)
long_tp1   = long_entry + long_risk * 1.5
long_tp2   = long_entry + long_risk * 3.0

short_entry = not na(bear_ob_bot)  ? bear_ob_bot  : (na(today_hi) ? close : today_hi - 1.0)
short_stop  = not na(bear_ob_stop) ? bear_ob_stop : (na(today_hi) ? close + 25 : today_hi + 25.0)
short_risk  = math.max(short_stop - short_entry, 0.25)
short_tp1   = short_entry - short_risk * 1.5
short_tp2   = short_entry - short_risk * 3.0

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL LABELS
// ═══════════════════════════════════════════════════════════════════════════════
var bool long_fired  = false
var bool short_fired = false
if new_day
    long_fired  := false
    short_fired := false

if show_score and long_signal and not long_fired
    long_fired := true
    _ld  = london_dir == "bullish" ? "London: ALIGNED" : london_dir == "bearish" ? "London: OPPOSED" : "London: neutral"
    _ms  = bull_mss_strong ? "MSS: STRONG" : "MSS: weak"
    _ob  = not na(bull_ob_top) ? "OB entry" : "Fixed entry"
    _lbl = str.tostring(long_score) + "/7 LONG  " + _ob + "\nEntry " + str.tostring(math.round(long_entry, 2)) + "  Stop " + str.tostring(math.round(long_stop, 2)) + "\nTP1 " + str.tostring(math.round(long_tp1, 2)) + "  TP2 " + str.tostring(math.round(long_tp2, 2)) + "\n" + _ld + "  " + _ms
    label.new(bar_index, long_stop - long_risk, _lbl, color=color.new(color.green, 5), textcolor=color.white, style=label.style_label_upper_right, size=size.normal)

if show_score and short_signal and not short_fired
    short_fired := true
    _ld  = london_dir == "bearish" ? "London: ALIGNED" : london_dir == "bullish" ? "London: OPPOSED" : "London: neutral"
    _ms  = bear_mss_strong ? "MSS: STRONG" : "MSS: weak"
    _ob  = not na(bear_ob_bot) ? "OB entry" : "Fixed entry"
    _lbl = str.tostring(short_score) + "/7 SHORT  " + _ob + "\nEntry " + str.tostring(math.round(short_entry, 2)) + "  Stop " + str.tostring(math.round(short_stop, 2)) + "\nTP1 " + str.tostring(math.round(short_tp1, 2)) + "  TP2 " + str.tostring(math.round(short_tp2, 2)) + "\n" + _ld + "  " + _ms
    label.new(bar_index, short_stop + short_risk, _lbl, color=color.new(color.red, 5), textcolor=color.white, style=label.style_label_lower_right, size=size.normal)

// TP and stop lines when signal fires
if long_signal and not long_signal[1]
    line.new(bar_index, long_tp2,   bar_index + 40, long_tp2,   color=color.new(color.green, 20), width=2)
    line.new(bar_index, long_tp1,   bar_index + 40, long_tp1,   color=color.new(color.green, 50), width=1)
    line.new(bar_index, long_entry, bar_index + 40, long_entry, color=color.white, width=1, style=line.style_dotted)
    line.new(bar_index, long_stop,  bar_index + 40, long_stop,  color=color.new(color.red, 20),   width=2)

if short_signal and not short_signal[1]
    line.new(bar_index, short_tp2,   bar_index + 40, short_tp2,   color=color.new(color.green, 20), width=2)
    line.new(bar_index, short_tp1,   bar_index + 40, short_tp1,   color=color.new(color.green, 50), width=1)
    line.new(bar_index, short_entry, bar_index + 40, short_entry, color=color.white, width=1, style=line.style_dotted)
    line.new(bar_index, short_stop,  bar_index + 40, short_stop,  color=color.new(color.red, 20),   width=2)

// ═══════════════════════════════════════════════════════════════════════════════
// DAY-OF-WEEK LABEL
// ═══════════════════════════════════════════════════════════════════════════════
var bool dow_shown = false
if new_day
    dow_shown := false
if show_dow and in_trade and not in_trade[1] and not dow_shown
    dow_shown := true
    _dname = dow == 2 ? "MONDAY" : dow == 3 ? "TUESDAY" : dow == 4 ? "WEDNESDAY" : dow == 5 ? "THURSDAY" : "FRIDAY"
    _dthr  = dow == 2 ? min_mon  : dow == 3 ? min_tue   : dow == 4 ? min_wed     : dow == 5 ? min_thu    : min_fri
    _dcol  = dow == 2 ? color.green : dow == 3 ? color.red : dow == 5 ? color.orange : color.blue
    label.new(bar_index, na(today_lo) ? low : today_lo - (na(today_hi) ? 10 : (today_hi - today_lo) * 0.3), _dname + "  Min: " + str.tostring(_dthr) + "/7", color=color.new(_dcol, 75), textcolor=_dcol, style=label.style_label_right, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// LIVE SCORE TABLE  (top-right)
// ═══════════════════════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 3, 11, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(tbl, 0, 0, "Point",   text_color=color.new(color.gray, 10), text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.cell(tbl, 1, 0, "LONG",    text_color=color.green,               text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.cell(tbl, 2, 0, "SHORT",   text_color=color.red,                 text_size=size.small, bgcolor=color.new(color.navy, 60))

    table.cell(tbl, 0, 1, "1. Sweep",   text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 2, "2. MSS",     text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 3, "3. FVG",     text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 4, "4. VWAP",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 5, "5. Time",    text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 6, "6. PDH/PDL", text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 0, 7, "7. OR opp",  text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 75))

    lpts = array.from(lp1, lp2, lp3, lp4, lp5, lp6, lp7)
    spts = array.from(sp1, sp2, sp3, sp4, sp5, sp6, sp7)
    for i = 0 to 6
        _lv = array.get(lpts, i)
        _sv = array.get(spts, i)
        table.cell(tbl, 1, i + 1, _lv == 1 ? "yes" : "-", text_color=_lv == 1 ? color.green : color.new(color.gray, 50), text_size=size.small, bgcolor=color.new(color.black, 75))
        table.cell(tbl, 2, i + 1, _sv == 1 ? "yes" : "-", text_color=_sv == 1 ? color.red   : color.new(color.gray, 50), text_size=size.small, bgcolor=color.new(color.black, 75))

    _lc = long_score  >= long_req  ? color.green : color.new(color.gray, 40)
    _sc = short_score >= short_req ? color.red   : color.new(color.gray, 40)
    table.cell(tbl, 0, 8, "SCORE",                                                        text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 1, 8, str.tostring(long_score)  + " / " + str.tostring(long_req),  text_color=_lc,          text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 2, 8, str.tostring(short_score) + " / " + str.tostring(short_req), text_color=_sc,          text_size=size.small, bgcolor=color.new(color.navy, 50))

    _ldc = london_dir == "bullish" ? color.green : london_dir == "bearish" ? color.red : color.gray
    table.cell(tbl, 0, 9,  "London",   text_color=color.new(color.gray, 10), text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 1, 9,  london_dir, text_color=_ldc,                      text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 2, 9,  or_done ? "OR: " + or_dir : "OR: wait", text_color=color.new(color.yellow, 10), text_size=size.small, bgcolor=color.new(color.black, 75))

    _sc2 = bar_is_strong ? color.lime : color.new(color.gray, 40)
    table.cell(tbl, 0, 10, "MSS str",                           text_color=color.new(color.gray, 10), text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 1, 10, bull_mss_strong ? "STRONG" : "weak", text_color=_sc2,                      text_size=size.small, bgcolor=color.new(color.black, 75))
    table.cell(tbl, 2, 10, bear_mss_strong ? "STRONG" : "weak", text_color=_sc2,                      text_size=size.small, bgcolor=color.new(color.black, 75))

// ═══════════════════════════════════════════════════════════════════════════════
// BACKGROUND SHADING
// ═══════════════════════════════════════════════════════════════════════════════
bgcolor(show_bg and in_prime               ? color.new(color.blue, 96) : na, title="Prime Window")
bgcolor(show_bg and in_trade and not in_prime ? color.new(color.gray, 97) : na, title="Late Window")
bgcolor(bull_sweep and not bull_sweep[1]   ? color.new(color.green, 90) : na, title="Bull Sweep Bar")
bgcolor(bear_sweep and not bear_sweep[1]   ? color.new(color.red,   90) : na, title="Bear Sweep Bar")

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(long_signal  and not long_signal[1],  "TJR Long Signal",   "LONG signal fired")
alertcondition(short_signal and not short_signal[1], "TJR Short Signal",  "SHORT signal fired")
alertcondition(bull_sweep   and not bull_sweep[1] and in_trade, "Asia Low Swept",   "Asia Low swept - watching for bullish MSS")
alertcondition(bear_sweep   and not bear_sweep[1] and in_trade, "Asia High Swept",  "Asia High swept - watching for bearish MSS")
alertcondition(bull_mss     and not bull_mss[1],     "Bullish MSS",       "Bullish MSS confirmed")
alertcondition(bear_mss     and not bear_mss[1],     "Bearish MSS",       "Bearish MSS confirmed")
